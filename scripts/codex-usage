#!/usr/bin/env python3
"""Codex の利用枠を表示する（取得間隔は最低5分）。外部依存なし。"""

import contextlib
import datetime
import email.utils
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import queue
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request


INTERVAL = 300
TIMEOUT = 20
RATE_LIMIT_WAIT = 900
USAGE_URL = "https://chatgpt.com/backend-api/codex/usage"
AUTH = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "auth.json"


class FetchError(Exception):
    def __init__(self, message, wait=INTERVAL):
        super().__init__(message)
        self.wait = wait


def read_auth():
    try:
        with AUTH.open() as stream:
            auth = json.load(stream)
        tokens = auth.get("tokens")
        return tokens if isinstance(tokens, dict) else {}
    except (OSError, ValueError, AttributeError):
        return {}


def app_server():
    if not shutil.which("codex"):
        raise FetchError("codex が見つかりません")
    messages = queue.Queue()
    deadline = time.monotonic() + TIMEOUT
    with subprocess.Popen(
        ["codex", "app-server", "--stdio"], stdin=subprocess.PIPE,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        encoding="utf-8", bufsize=1,
    ) as process:
        def reader():
            try:
                for line in process.stdout:
                    messages.put(line)
            finally:
                messages.put(None)

        thread = threading.Thread(target=reader, daemon=True)
        thread.start()

        def send(message):
            process.stdin.write(json.dumps(message) + "\n")
            process.stdin.flush()

        def receive(wanted):
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise FetchError("Codex app-server がタイムアウトしました")
                try:
                    line = messages.get(timeout=remaining)
                except queue.Empty:
                    raise FetchError("Codex app-server がタイムアウトしました") from None
                if line is None:
                    raise FetchError("Codex app-server が切断されました")
                reply = json.loads(line)
                if not isinstance(reply, dict) or reply.get("id") != wanted:
                    continue
                if "error" in reply:
                    error = reply["error"]
                    message = error.get("message", str(error)) if isinstance(error, dict) else str(error)
                    throttled = any(word in message.lower() for word in (
                        "429", "too many requests", "rate limit exceeded",
                        "rate limit reached", "rate_limit_exceeded", "rate limited",
                    ))
                    raise FetchError(message, RATE_LIMIT_WAIT if throttled else INTERVAL)
                if not isinstance(reply.get("result"), dict):
                    raise FetchError("Codex app-server の応答が不正です")
                return reply["result"]

        try:
            send({"id": 1, "method": "initialize", "params": {
                "clientInfo": {"name": "usage-check", "version": "2.0"}}})
            receive(1)
            send({"method": "initialized"})
            send({"id": 2, "method": "account/rateLimits/read"})
            return receive(2)
        finally:
            # 終了待ちにも上限を設け、パイプと子プロセスを確実に回収する。
            with contextlib.suppress(OSError):
                process.stdin.close()
            if process.poll() is None:
                process.terminate()
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
            thread.join(timeout=1)


def retry_after(value):
    try:
        return max(RATE_LIMIT_WAIT, float(value))
    except (ValueError, TypeError):
        try:
            return max(RATE_LIMIT_WAIT, email.utils.parsedate_to_datetime(value).timestamp() - time.time())
        except (ValueError, TypeError, OverflowError):
            return RATE_LIMIT_WAIT


def direct():
    tokens = read_auth()
    if not tokens.get("access_token"):
        raise FetchError("Codex アカウントの認証が必要です。'codex login' を実行してください。")
    request = urllib.request.Request(USAGE_URL, headers={
        "Authorization": "Bearer " + tokens["access_token"],
        "chatgpt-account-id": tokens.get("account_id", ""),
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0",
    })
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        if error.code == 429:
            raise FetchError("使用量 API のレートリミット（HTTP 429）", retry_after(error.headers.get("Retry-After"))) from None
        raise FetchError(f"使用量 API エラー: HTTP {error.code}（認証状態は 'codex login' で確認してください）") from None


def windows(limits, api=False):
    if not isinstance(limits, dict):
        raise FetchError("使用量の応答に利用枠がありません")
    result = []
    for kind in ("primary", "secondary"):
        item = limits.get(kind + "_window" if api else kind)
        if not isinstance(item, dict):
            continue
        used = item.get("used_percent" if api else "usedPercent")
        duration = item.get("limit_window_seconds" if api else "windowDurationMins")
        reset = item.get("reset_at" if api else "resetsAt")
        for value in (used, duration, reset):
            if value is not None and (isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < 0):
                raise FetchError("使用量の応答に不正な数値があります")
        if used is None:
            raise FetchError("使用率が応答にありません")
        result.append({"minutes": duration / 60 if api and duration is not None else duration,
                       "used": used, "reset": reset, "kind": kind})
    if not result:
        raise FetchError("使用量の応答に利用枠がありません")
    return result


def fetch():
    try:
        return windows(app_server().get("rateLimits"))
    except FetchError as error:
        # 制限中はフォールバックでさらにリクエストを送らない。
        if error.wait >= RATE_LIMIT_WAIT or not read_auth().get("access_token"):
            raise
    except (OSError, ValueError):
        pass
    usage = direct()
    return windows(usage.get("rate_limit") if isinstance(usage, dict) else None, api=True)


def load_cache(path):
    try:
        with path.open() as stream:
            state = json.load(stream)
        if not isinstance(state, dict) or not isinstance(state.get("next_attempt"), (int, float)):
            return {}
        return state
    except (OSError, ValueError):
        return {}


def save_cache(path, state):
    fd, temporary = tempfile.mkstemp(prefix=".usage-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(state, stream)
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)


def main():
    # 認証トークンは保存せず、アカウント・CODEX_HOME ごとにキャッシュを分ける。
    identity = str(AUTH.resolve()) + "\0" + str(read_auth().get("account_id", ""))
    key = hashlib.sha256(identity.encode()).hexdigest()[:24]
    directory = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "codex-usage"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = directory / (key + ".json")
    with (directory / (key + ".lock")).open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_cache(path)
        if time.time() >= state.get("next_attempt", 0):
            # 途中終了した場合も連続取得を避けるため、取得前に待機期限を保存。
            state["next_attempt"] = time.time() + INTERVAL
            save_cache(path, state)
            try:
                data = fetch()
            except (FetchError, OSError, ValueError) as error:
                state.update(error=str(error), next_attempt=time.time() + getattr(error, "wait", INTERVAL))
            else:
                state = {"data": data, "fetched_at": time.time(), "next_attempt": time.time() + INTERVAL}
            save_cache(path, state)
    if state.get("error"):
        print(f"取得できません: {state['error']}（再取得は {max(0, math.ceil(state['next_attempt'] - time.time()))} 秒後以降）", file=sys.stderr)
    if not state.get("data"):
        if not state.get("error"):
            print("使用量を取得できませんでした。再取得までしばらくお待ちください。", file=sys.stderr)
        return 1
    if state.get("error") or time.time() - state.get("fetched_at", 0) >= INTERVAL:
        fetched = datetime.datetime.fromtimestamp(state["fetched_at"]).strftime("%Y-%m-%d %H:%M:%S")
        print(f"前回取得値を表示しています（取得日時: {fetched}）", file=sys.stderr)
    for item in state["data"]:
        duration = item["minutes"]
        label = {300: "5時間", 10080: "週間"}.get(duration)
        label = label or (f"{duration:g}分" if duration is not None else item["kind"])
        print(f"{label}: 残り {100 - item['used']:g}%")
        if item["reset"] is not None:
            reset = datetime.datetime.fromtimestamp(item["reset"]).strftime("%Y-%m-%d %H:%M:%S")
            print(f"  リセット: {reset}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"codex-usage エラー: {error}", file=sys.stderr)
        sys.exit(1)
